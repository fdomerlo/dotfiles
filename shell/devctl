#!/usr/bin/env bash
set -euo pipefail

# Resolver la ruta real del script independientemente de enlaces simbólicos
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BASE_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

log() { echo -e "\n==> $1"; }

require() {
  command -v "$1" >/dev/null || { echo "Missing: $1"; exit 1; }
}

# --------------------------------------------------
# ACTUALIZACIÓN
# --------------------------------------------------

update() {
  log "Actualizando estación (idempotente, sin tocar SSH)..."
  bash "$BASE_DIR/scripts/update.sh"
}

# --------------------------------------------------
# DIAGNÓSTICO
# --------------------------------------------------

doctor() {
  log "Ejecutando diagnóstico del entorno Debian..."

  check() {
    if command -v "$1" >/dev/null || [ -f "$HOME/.local/bin/$1" ]; then
      echo -e "  \033[32m✔\033[0m $1"
    else
      echo -e "  \033[31m✘\033[0m $1"
    fi
  }

  check_opt() {
    if command -v "$1" >/dev/null || [ -f "$HOME/.local/bin/$1" ]; then
      echo -e "  \033[32m✔\033[0m $1"
    else
      echo -e "  \033[33m○\033[0m $1 (opcional)"
    fi
  }

  echo "Herramientas del Host:"
  check git
  check gh
  check zsh
  check uv
  check fnm
  check code
  check zed
  check opencode
  check antigravity
  check_opt timeshift

  echo ""
  echo "Tríada CLI Moderna:"
  check_opt rg
  check_opt fdfind
  check_opt fzf
  check_opt batcat
  check_opt btop
  check_opt direnv
  check_opt wl-copy

  echo ""
  echo "Podman Rootless:"
  if command -v podman &>/dev/null; then
    echo -e "  \033[32m✔\033[0m Binario podman presente ($(podman --version))"
    if [ "$(podman info --format '{{.Host.Security.Rootless}}' 2>/dev/null)" = "true" ]; then
      echo -e "  \033[32m✔\033[0m Podman Rootless activo y operativo"
    else
      echo -e "  \033[31m✘\033[0m Podman no se está ejecutando en modo Rootless"
    fi
  else
    echo -e "  \033[31m✘\033[0m podman no instalado"
  fi

  if [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock" ]; then
    echo -e "  \033[32m✔\033[0m Socket Podman/Docker activo (${XDG_RUNTIME_DIR}/podman/podman.sock)"
  fi

  echo ""
  echo "GitHub (solo lectura):"
  KEY_ARGS=()
  [ -f "$HOME/.ssh/id_ed25519" ] && KEY_ARGS=(-i "$HOME/.ssh/id_ed25519")
  SSH_REPLY=$(ssh -T "${KEY_ARGS[@]}" -o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=5 git@github.com 2>&1 || true)
  if echo "$SSH_REPLY" | grep -q "successfully authenticated"; then
    SSH_USER=$(echo "$SSH_REPLY" | sed -n 's/^Hi \([^!]*\)!.*/\1/p')
    echo -e "  \033[32m✔\033[0m SSH autenticado como ${SSH_USER:-usuario}"
  else
    echo -e "  \033[31m✘\033[0m SSH con GitHub no autenticado"
  fi
  # `gh auth status` puede devolver 0 con un token muerto; validar contra la API.
  GH_USER=""
  if command -v gh &>/dev/null; then
    GH_USER=$(gh api user --jq '.login' 2>/dev/null || true)
  fi
  if [[ "$GH_USER" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,37}[A-Za-z0-9])?$ ]]; then
    echo -e "  \033[32m✔\033[0m gh autenticado como $GH_USER"
  else
    echo -e "  \033[31m✘\033[0m gh sin sesión válida (gh auth login -h github.com -p ssh -w)"
  fi

  echo ""
  echo "Memoria y Swap:"
  swapon --show || echo "No hay swap activo"

  echo ""
  echo "Estado de zRAM:"
  if command -v zramctl &>/dev/null; then
    zramctl || echo "zRAM inactivo"
  elif grep -q "zram" /proc/swaps; then
    grep "zram" /proc/swaps
  else
    echo "No se detectó dispositivo zRAM"
  fi
}

# --------------------------------------------------
# ROUTER
# --------------------------------------------------

case "${1:-}" in
doctor) doctor ;;

update) update ;;

*)
  echo "devctl - Workstation CLI para Debian"
  echo ""
  echo "Uso:"
  echo "  devctl doctor                # Diagnóstico del entorno y servicios"
  echo "  devctl update                # Actualiza estación (APT only-upgrade + user-space)"
  ;;
esac

#!/usr/bin/env bash
set -euo pipefail

# Resolver la ruta real del script independientemente de enlaces simbólicos
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BASE_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

# Asegurar presencia de rutas administrativas de Debian (swapon, zramctl, etc.)
export PATH="$PATH:/usr/local/sbin:/usr/sbin:/sbin"

log() { echo -e "\n==> $1"; }

require() {
  command -v "$1" >/dev/null || { echo "Missing: $1"; exit 1; }
}

# --------------------------------------------------
# SNAPSHOTS Y ROLLBACK (TIMESHIFT)
# --------------------------------------------------

snapshot() {
  require timeshift
  local comment="${1:-Snapshot manual devctl}"
  log "Creando snapshot de sistema con Timeshift ($comment)..."
  sudo timeshift --create --comments "$comment" --scripted
}

rollback() {
  require timeshift
  log "Listando snapshots disponibles en Timeshift..."
  sudo timeshift --list
  log "Iniciando restauración interactiva con Timeshift..."
  sudo timeshift --restore
}

# --------------------------------------------------
# AUDITORÍA Y ADOPCIÓN
# --------------------------------------------------

audit() {
  bash "$BASE_DIR/scripts/audit-system.sh" || true
}

adopt() {
  log "Iniciando adopción y nivelación de la estación preexistente..."
  sudo bash "$BASE_DIR/scripts/adopt-system.sh" "$@"
  log "Continuando con la configuración del entorno de usuario..."
  make -C "$BASE_DIR" podman shell devtools tooling devai desktop clean
}

# --------------------------------------------------
# ACTUALIZACIÓN
# --------------------------------------------------

update() {
  if [[ "${1:-}" == "--snapshot" || "${1:-}" == "-s" ]]; then
    snapshot "Pre-update devctl"
    log "Actualizando estación (idempotente, sin tocar SSH)..."
    SKIP_SNAPSHOT=1 bash "$BASE_DIR/scripts/update.sh"
  else
    log "Actualizando estación (idempotente, sin tocar SSH)..."
    bash "$BASE_DIR/scripts/update.sh"
  fi
}

# --------------------------------------------------
# LIMPIEZA PROFUNDA
# --------------------------------------------------

clean_deep() {
  log "Ejecutando limpieza profunda post-upgrade..."
  bash "$BASE_DIR/scripts/clean-system.sh"
}

# --------------------------------------------------
# DIAGNÓSTICO
# --------------------------------------------------

doctor() {
  log "Ejecutando diagnóstico del entorno Debian Testing..."

  check() {
    if command -v "$1" >/dev/null || [ -f "$HOME/.local/bin/$1" ]; then
      echo -e "  \033[32m✔\033[0m $1"
    else
      echo -e "  \033[31m✘\033[0m $1"
    fi
  }

  check_opt() {
    if command -v "$1" >/dev/null || [ -f "$HOME/.local/bin/$1" ]; then
      echo -e "  \033[32m✔\033[0m $1"
    else
      echo -e "  \033[33m○\033[0m $1 (opcional)"
    fi
  }

  echo "Sistema Base:"
  echo -e "  \033[32m✔\033[0m Debian Testing ($(uname -r), $(uname -m))"

  echo ""
  echo "Guardarraíles de Estabilidad (Testing):"
  check_opt apt-listbugs
  check_opt apt-listchanges
  check_opt needrestart
  if [ -f /etc/apt/preferences.d/00-testing-pinning.pref ]; then
    echo -e "  \033[32m✔\033[0m APT Pinning activo (Testing=900 / Stable-Sec=500 / Sid=100)"
  else
    echo -e "  \033[31m✘\033[0m APT Pinning ausente"
  fi

  echo ""
  echo "Herramientas del Host:"
  check git
  check gh
  check zsh
  check uv
  check fnm
  check code
  check zed
  check opencode
  check antigravity
  check_opt agy
  check_opt timeshift

  echo ""
  echo "Tríada CLI Moderna:"
  check_opt rg
  check_opt fdfind
  check_opt fzf
  check_opt batcat
  check_opt btop
  check_opt direnv
  check_opt wl-copy

  echo ""
  echo "Podman Rootless:"
  if command -v podman &>/dev/null; then
    echo -e "  \033[32m✔\033[0m Binario podman presente ($(podman --version))"
    if [ "$(podman info --format '{{.Host.Security.Rootless}}' 2>/dev/null)" = "true" ] || [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock" ]; then
      echo -e "  \033[32m✔\033[0m Podman Rootless activo y operativo"
    else
      echo -e "  \033[31m✘\033[0m Podman no se está ejecutando en modo Rootless"
    fi
  else
    echo -e "  \033[31m✘\033[0m podman no instalado"
  fi

  if [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock" ]; then
    echo -e "  \033[32m✔\033[0m Socket Podman/Docker activo (${XDG_RUNTIME_DIR}/podman/podman.sock)"
  fi

  echo ""
  echo "GitHub (solo lectura):"
  KEY_ARGS=()
  [ -f "$HOME/.ssh/id_ed25519" ] && KEY_ARGS=(-i "$HOME/.ssh/id_ed25519")
  SSH_REPLY=$(ssh -T "${KEY_ARGS[@]}" -o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=5 git@github.com 2>&1 || true)
  if echo "$SSH_REPLY" | grep -q "successfully authenticated"; then
    SSH_USER=$(echo "$SSH_REPLY" | sed -n 's/^Hi \([^!]*\)!.*/\1/p')
    echo -e "  \033[32m✔\033[0m SSH autenticado como ${SSH_USER:-usuario}"
  else
    echo -e "  \033[31m✘\033[0m SSH con GitHub no autenticado"
  fi
  # `gh auth status` puede devolver 0 con un token muerto; validar contra la API.
  GH_USER=""
  if command -v gh &>/dev/null; then
    GH_USER=$(gh api user --jq '.login' 2>/dev/null || true)
  fi
  if [[ "$GH_USER" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,37}[A-Za-z0-9])?$ ]]; then
    echo -e "  \033[32m✔\033[0m gh autenticado como $GH_USER"
  else
    echo -e "  \033[31m✘\033[0m gh sin sesión válida (gh auth login -h github.com -p ssh -w)"
  fi

  echo ""
  echo "Entorno y Escritorio:"
  if [ -d "${XDG_PROJECTS_DIR:-$HOME/Proyectos}" ]; then
    echo -e "  \033[32m✔\033[0m Directorio de proyectos: ${XDG_PROJECTS_DIR:-$HOME/Proyectos}"
  else
    echo -e "  \033[31m✘\033[0m Directorio de proyectos (${XDG_PROJECTS_DIR:-$HOME/Proyectos}) no encontrado"
  fi
  if [ -d "${XDG_APPLICATIONS_DIR:-$HOME/Aplicaciones}" ]; then
    echo -e "  \033[32m✔\033[0m Directorio de aplicaciones portables: ${XDG_APPLICATIONS_DIR:-$HOME/Aplicaciones}"
  else
    echo -e "  \033[33m○\033[0m Directorio de aplicaciones portables (${XDG_APPLICATIONS_DIR:-$HOME/Aplicaciones}) no creado"
  fi
  BTN_LAYOUT=$(gsettings get org.gnome.desktop.wm.preferences button-layout 2>/dev/null || echo "''")
  if [[ "$BTN_LAYOUT" == *"minimize"* && "$BTN_LAYOUT" == *"maximize"* && "$BTN_LAYOUT" == *"close"* ]]; then
    echo -e "  \033[32m✔\033[0m Botones de ventana configurados ($BTN_LAYOUT)"
  else
    echo -e "  \033[33m○\033[0m Botones de ventana sin layout completo ($BTN_LAYOUT)"
  fi
  if command -v flatpak &>/dev/null && flatpak remotes 2>/dev/null | grep -q "flathub"; then
    echo -e "  \033[32m✔\033[0m Flatpak con Flathub activo"
  elif command -v flatpak &>/dev/null; then
    echo -e "  \033[33m○\033[0m Flatpak instalado (Flathub no configurado)"
  else
    echo -e "  \033[31m✘\033[0m Flatpak no instalado"
  fi
  if dpkg -s libfuse2t64 &>/dev/null || dpkg -s libfuse2 &>/dev/null || [ -e /usr/lib/x86_64-linux-gnu/libfuse.so.2 ] || { dpkg -s fuse3 &>/dev/null && grep -q "^APPIMAGE_EXTRACT_AND_RUN=1" /etc/environment 2>/dev/null; }; then
    echo -e "  \033[32m✔\033[0m Soporte AppImage FUSE / Extract-and-Run presente"
  else
    echo -e "  \033[33m○\033[0m Soporte AppImage no detectado (opcional para AppImages)"
  fi

  echo ""
  echo "Memoria y Swap:"
  if command -v swapon &>/dev/null; then
    swapon --show || echo "No hay swap activo"
  elif [ -x /usr/sbin/swapon ]; then
    /usr/sbin/swapon --show || echo "No hay swap activo"
  elif [ -r /proc/swaps ] && [ "$(wc -l < /proc/swaps)" -gt 1 ]; then
    cat /proc/swaps
  else
    echo "No hay swap activo"
  fi

  echo ""
  echo "Estado de zRAM:"
  if command -v zramctl &>/dev/null; then
    zramctl || echo "zRAM inactivo"
  elif [ -x /usr/sbin/zramctl ]; then
    /usr/sbin/zramctl || echo "zRAM inactivo"
  elif grep -q "zram" /proc/swaps 2>/dev/null; then
    grep "zram" /proc/swaps
  else
    echo "No se detectó dispositivo zRAM"
  fi
}

# --------------------------------------------------
# ROUTER
# --------------------------------------------------

case "${1:-}" in
doctor) doctor ;;

audit) audit ;;

adopt)
  shift
  adopt "$@"
  ;;

update)
  shift
  update "${1:-}"
  ;;

snapshot)
  shift
  snapshot "${*:-}"
  ;;

rollback)
  rollback
  ;;

clean) clean_deep ;;

*)
  echo "devctl - Workstation CLI para Debian Testing"
  echo ""
  echo "Uso:"
  echo "  devctl doctor                # Diagnóstico del entorno, guardarraíles de estabilidad y servicios"
  echo "  devctl audit                 # Audita estación vs preseed.cfg y make install (adopción vs reinstalar)"
  echo "  devctl adopt [--force]       # Nivelación base (zRAM, microcode, sysctl, fstab) + make install"
  echo "  devctl update [--snapshot]   # Actualiza estación (con snapshot previo opcional en Timeshift)"
  echo "  devctl snapshot [comentario] # Crea un snapshot manual del sistema con Timeshift"
  echo "  devctl rollback              # Lista snapshots e inicia restauración interactiva con Timeshift"
  echo "  devctl clean                 # Limpieza profunda post-upgrade (purga rc, huérfanos, logs)"
  ;;
esac

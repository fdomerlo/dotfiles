#!/usr/bin/env bash
set -euo pipefail

# Resolver la ruta real del script independientemente de enlaces simbólicos
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BASE_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

# Asegurar presencia de rutas administrativas de Debian (swapon, zramctl, etc.)
export PATH="$PATH:/usr/local/sbin:/usr/sbin:/sbin"

log() { echo -e "\n==> $1"; }

require() {
  command -v "$1" >/dev/null || { echo "Missing: $1"; exit 1; }
}

# --------------------------------------------------
# ACTUALIZACIÓN
# --------------------------------------------------

update() {
  log "Actualizando estación (idempotente, sin tocar SSH)..."
  bash "$BASE_DIR/scripts/update.sh"
}

# --------------------------------------------------
# LIMPIEZA PROFUNDA
# --------------------------------------------------

clean_deep() {
  log "Ejecutando limpieza profunda post-upgrade..."
  bash "$BASE_DIR/scripts/clean-system.sh"
}

# --------------------------------------------------
# WEB APPS (PWAs)
# --------------------------------------------------

webapp() {
  local script="$BASE_DIR/hypr/scripts/webapp-install.sh"
  [ -x "$script" ] || [ -f "$script" ] || { echo "No se encontró $script"; exit 1; }
  bash "$script" "$@"
}

# --------------------------------------------------
# DIAGNÓSTICO
# --------------------------------------------------

doctor() {
  local debian_codename
  debian_codename=$(grep -oP '(?<=VERSION_CODENAME=).*' /etc/os-release 2>/dev/null || echo "")

  log "Ejecutando diagnóstico del entorno Debian..."

  check() {
    if command -v "$1" >/dev/null || [ -f "$HOME/.local/bin/$1" ]; then
      echo -e "  \033[32m✔\033[0m $1"
    else
      echo -e "  \033[31m✘\033[0m $1"
    fi
  }

  check_opt() {
    if command -v "$1" >/dev/null || [ -f "$HOME/.local/bin/$1" ]; then
      echo -e "  \033[32m✔\033[0m $1"
    else
      echo -e "  \033[33m○\033[0m $1 (opcional)"
    fi
  }

  echo "Sistema Base:"
  echo -e "  \033[32m✔\033[0m Debian${debian_codename:+ $debian_codename} ($(uname -r), $(uname -m))"

  echo ""
  echo "Herramientas del Host:"
  check git
  check gh
  check zsh
  check uv
  check fnm
  check code
  check zed
  check opencode
  check antigravity
  check_opt google-chrome
  check_opt agy
  check_opt lazydocker
  check_opt remmina
  check_opt wireshark
  check_opt zathura
  check_opt imv
  check_opt timeshift

  echo ""
  echo "Tríada CLI Moderna:"
  check_opt rg
  check_opt fdfind
  check_opt fzf
  check_opt batcat
  check_opt btop
  check_opt direnv
  check_opt wl-copy

  echo ""
  echo "Podman Rootless:"
  if command -v podman &>/dev/null; then
    echo -e "  \033[32m✔\033[0m Binario podman presente ($(podman --version))"
    if [ "$(podman info --format '{{.Host.Security.Rootless}}' 2>/dev/null)" = "true" ] || [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock" ]; then
      echo -e "  \033[32m✔\033[0m Podman Rootless activo y operativo"
    else
      echo -e "  \033[31m✘\033[0m Podman no se está ejecutando en modo Rootless"
    fi
  else
    echo -e "  \033[31m✘\033[0m podman no instalado"
  fi

  if [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock" ]; then
    echo -e "  \033[32m✔\033[0m Socket Podman/Docker activo (${XDG_RUNTIME_DIR}/podman/podman.sock)"
  fi

  echo ""
  echo "GitHub (solo lectura):"
  KEY_ARGS=()
  [ -f "$HOME/.ssh/id_ed25519" ] && KEY_ARGS=(-i "$HOME/.ssh/id_ed25519")
  SSH_REPLY=$(ssh -T "${KEY_ARGS[@]}" -o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=5 git@github.com 2>&1 || true)
  if grep -q "successfully authenticated" <<<"$SSH_REPLY"; then
    SSH_USER=$(echo "$SSH_REPLY" | sed -n 's/^Hi \([^!]*\)!.*/\1/p')
    echo -e "  \033[32m✔\033[0m SSH autenticado como ${SSH_USER:-usuario}"
  else
    echo -e "  \033[31m✘\033[0m SSH con GitHub no autenticado"
  fi
  if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "$SSH_AUTH_SOCK" ]; then
    echo -e "  \033[32m✔\033[0m SSH_AUTH_SOCK activo ($SSH_AUTH_SOCK)"
  else
    echo -e "  \033[33m○\033[0m SSH_AUTH_SOCK inactivo (${SSH_AUTH_SOCK:-unset})"
  fi
  # `gh auth status` puede devolver 0 con un token muerto; validar contra la API.
  GH_USER=""
  if command -v gh &>/dev/null; then
    GH_USER=$(gh api user --jq '.login' 2>/dev/null || true)
  fi
  if [[ "$GH_USER" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,37}[A-Za-z0-9])?$ ]]; then
    echo -e "  \033[32m✔\033[0m gh autenticado como $GH_USER"
  else
    echo -e "  \033[31m✘\033[0m gh sin sesión válida (gh auth login -h github.com -p ssh -w)"
  fi

  echo ""
  echo "Entorno y Escritorio:"
  if [ -d "${XDG_PROJECTS_DIR:-$HOME/Proyectos}" ]; then
    echo -e "  \033[32m✔\033[0m Directorio de proyectos: ${XDG_PROJECTS_DIR:-$HOME/Proyectos}"
  else
    echo -e "  \033[31m✘\033[0m Directorio de proyectos (${XDG_PROJECTS_DIR:-$HOME/Proyectos}) no encontrado"
  fi
  if [ -d "${XDG_APPLICATIONS_DIR:-$HOME/Aplicaciones}" ]; then
    echo -e "  \033[32m✔\033[0m Directorio de aplicaciones portables: ${XDG_APPLICATIONS_DIR:-$HOME/Aplicaciones}"
  else
    echo -e "  \033[33m○\033[0m Directorio de aplicaciones portables (${XDG_APPLICATIONS_DIR:-$HOME/Aplicaciones}) no creado"
  fi
  if command -v flatpak &>/dev/null && flatpak remotes 2>/dev/null | grep -q "flathub"; then
    echo -e "  \033[32m✔\033[0m Flatpak con Flathub activo"
  elif command -v flatpak &>/dev/null; then
    echo -e "  \033[33m○\033[0m Flatpak instalado (Flathub no configurado)"
  else
    echo -e "  \033[31m✘\033[0m Flatpak no instalado"
  fi
  if dpkg -s libfuse2t64 &>/dev/null || dpkg -s libfuse2 &>/dev/null || [ -e /usr/lib/x86_64-linux-gnu/libfuse.so.2 ]; then
    echo -e "  \033[32m✔\033[0m Soporte AppImage FUSE presente"
  else
    echo -e "  \033[33m○\033[0m Biblioteca FUSE 2 no detectada (opcional para AppImages)"
  fi

  echo ""
  echo "Hyprland:"
  if command -v Hyprland &>/dev/null; then
    if [ -r "$BASE_DIR/scripts/hyprland-packages.sh" ]; then
      # shellcheck source=scripts/hyprland-packages.sh
      source "$BASE_DIR/scripts/hyprland-packages.sh"
      for cmd in "${HYPR_REQUIRED_BINS[@]}"; do
        [ "$cmd" = "Hyprland" ] && continue
        check "$cmd"
      done
    else
      for cmd in hyprctl hypridle hyprlock hyprpicker hyprsunset waybar rofi fuzzel foot swappy wf-recorder; do
        check "$cmd"
      done
    fi
    if [ -x /usr/libexec/hyprpolkitagent ]; then
      echo -e "  \033[32m✔\033[0m hyprpolkitagent"
    else
      echo -e "  \033[31m✘\033[0m hyprpolkitagent"
    fi
    if [ -f /usr/share/wayland-sessions/hyprland.desktop ]; then
      echo -e "  \033[32m✔\033[0m Sesión disponible en GDM"
    else
      echo -e "  \033[31m✘\033[0m Sesión hyprland.desktop no encontrada"
    fi
    if [ -f /usr/share/xdg-desktop-portal/portals/hyprland.portal ]; then
      echo -e "  \033[32m✔\033[0m Portal xdg-desktop-portal-hyprland"
    else
      echo -e "  \033[31m✘\033[0m Portal xdg-desktop-portal-hyprland no encontrado"
    fi
    if [ -e "$HOME/.config/hypr/hyprland.lua" ] && [ -e "$HOME/.config/xdg-desktop-portal/hyprland-portals.conf" ]; then
      echo -e "  \033[32m✔\033[0m Configuración y portales desplegados en ~/.config"
    else
      echo -e "  \033[33m○\033[0m Configuración/portales incompletos (ejecuta 'make hyprland')"
    fi
    if [ -d /usr/share/icons/Bibata-Modern-Classic ] || [ -d "$HOME/.local/share/icons/Bibata-Modern-Classic" ]; then
      echo -e "  \033[32m✔\033[0m Cursor Bibata-Modern-Classic"
    else
      echo -e "  \033[33m○\033[0m Cursor Bibata-Modern-Classic pendiente ('sudo apt-get install -y bibata-cursor-theme')"
    fi
    local fc_fonts
    fc_fonts="$(fc-list : family 2>/dev/null || true)"
    if grep -iqE '(^|,)Inter(,|$)' <<<"$fc_fonts" \
        && grep -iqE '(^|,)Atkinson Hyperlegible(,|$)' <<<"$fc_fonts" \
        && grep -iqE '(^|,)JetBrains Mono(,|$)' <<<"$fc_fonts"; then
      echo -e "  \033[32m✔\033[0m Tipografías Debian (Inter / Atkinson Hyperlegible / JetBrains Mono)"
    else
      echo -e "  \033[33m○\033[0m Faltan tipografías Debian Hyprland ('sudo apt-get install -y fonts-inter fonts-atkinson-hyperlegible fonts-jetbrains-mono')"
    fi
  else
    echo -e "  \033[33m○\033[0m Hyprland no instalado (base-install; agrega con: make hyprland)"
  fi

  echo ""
  echo "Memoria y Swap:"
  if command -v swapon &>/dev/null; then
    swapon --show || echo "No hay swap activo"
  elif [ -x /usr/sbin/swapon ]; then
    /usr/sbin/swapon --show || echo "No hay swap activo"
  elif [ -r /proc/swaps ] && [ "$(wc -l < /proc/swaps)" -gt 1 ]; then
    cat /proc/swaps
  else
    echo "No hay swap activo"
  fi

  echo ""
  echo "Estado de zRAM:"
  if command -v zramctl &>/dev/null; then
    zramctl || echo "zRAM inactivo"
  elif [ -x /usr/sbin/zramctl ]; then
    /usr/sbin/zramctl || echo "zRAM inactivo"
  elif grep -q "zram" /proc/swaps 2>/dev/null; then
    grep "zram" /proc/swaps
  else
    echo "No se detectó dispositivo zRAM"
  fi
}

# --------------------------------------------------
# ROUTER
# --------------------------------------------------

case "${1:-}" in
doctor) doctor ;;

update) update ;;

clean) clean_deep ;;

webapp)
  shift
  webapp "$@"
  ;;

*)
  echo "devctl - Workstation CLI para Debian"
  echo ""
  echo "Uso:"
  echo "  devctl doctor                # Diagnóstico del entorno y servicios"
  echo "  devctl update                # Actualiza estación (APT only-upgrade + user-space)"
  echo "  devctl clean                 # Limpieza profunda post-upgrade (purga rc, huérfanos, logs)"
  echo "  devctl webapp <subcomando>   # Gestiona Web Apps/PWAs (install, list, remove, menu)"
  ;;
esac

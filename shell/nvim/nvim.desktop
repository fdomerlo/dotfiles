[Desktop Entry]
Name=Neovim
GenericName=Text Editor
Comment=Edit text files in terminal
TryExec=foot
Exec=sh -c 'PATH="$HOME/.local/bin:$PATH" exec foot -e nvim "$@"' -- %F
Icon=nvim
Terminal=false
Type=Application
Categories=Utility;TextEditor;Development;IDE;
Keywords=Text;editor;vim;nvim;
StartupNotify=false
MimeType=text/plain;text/x-makefile;text/x-c++hdr;text/x-c++src;text/x-chdr;text/x-csrc;text/x-java;text/x-shellscript;

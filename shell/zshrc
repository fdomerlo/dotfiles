# ---------------------------------------------------------------------------
# Zsh y Oh My Zsh - Configuración Principal (Debian Workstation)
# ---------------------------------------------------------------------------

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""

plugins=(
  git
  common-aliases
  extract
  colored-man-pages
  zsh-autosuggestions
  zsh-syntax-highlighting
)

if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

# ---------------------------------------------------------------------------
# Consolidación de PATH y Toolchains (Deduplicado e Idempotente)
# ---------------------------------------------------------------------------

# Garantizar unicidad de entradas en PATH dentro de Zsh
typeset -U path PATH

export FNM_DIR="$HOME/.local/share/fnm"
export SDKMAN_DIR="$HOME/.sdkman"

path=(
  "$HOME/.local/bin"
  "$HOME/Aplicaciones"
  "$HOME/.opencode/bin"
  "$FNM_DIR"
  "$HOME/bin"
  /usr/local/bin
  /usr/local/sbin
  /usr/sbin
  /sbin
  $path
)
export PATH

# --- UV (Python) ---
[[ -f "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"

# --- FNM (Node.js) ---
if command -v fnm &>/dev/null; then
  eval "$(fnm env --use-on-cd --shell zsh)"
fi

# --- SDKMAN (Java/JVM) ---
if [[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]]; then
  source "$SDKMAN_DIR/bin/sdkman-init.sh"
fi

# Reasegurar deduplicación de PATH tras inicializadores externos
typeset -U path PATH

# --- Direnv & FZF (Tríada CLI Moderna en Debian) ---
if command -v direnv &>/dev/null; then
  eval "$(direnv hook zsh)"
fi
[[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]] && source /usr/share/doc/fzf/examples/key-bindings.zsh
[[ -f /usr/share/doc/fzf/examples/completion.zsh ]] && source /usr/share/doc/fzf/examples/completion.zsh

# --- Directorios de Trabajo y XDG ---
export XDG_PROJECTS_DIR="${XDG_PROJECTS_DIR:-$HOME/Proyectos}"
export XDG_APPLICATIONS_DIR="${XDG_APPLICATIONS_DIR:-$HOME/Aplicaciones}"
export PROJECTS="$XDG_PROJECTS_DIR"
alias pdir="cd $XDG_PROJECTS_DIR"
alias adir="cd $XDG_APPLICATIONS_DIR"

# --- Podman / Docker Rootless Socket ---
if [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock" ]; then
  export DOCKER_HOST="unix://${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"
elif [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/docker.sock" ]; then
  export DOCKER_HOST="unix://${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/docker.sock"
fi

# --- Zoxide (cd inteligente con frecencia de uso) ---
if command -v zoxide &>/dev/null; then
  eval "$(zoxide init zsh)"
fi

# --- Atuin (historial de comandos buscable y sincronizable) ---
if command -v atuin &>/dev/null; then
  eval "$(atuin init zsh)"
fi

# --- Prompt: Starship si está disponible; si no, vcs_info nativo ---
if command -v starship &>/dev/null; then
  export STARSHIP_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/starship.toml"
  eval "$(starship init zsh)"
else
  setopt prompt_subst
  autoload -Uz vcs_info
  zstyle ':vcs_info:*' enable git
  zstyle ':vcs_info:git:*' formats ' (%b)'

  precmd() {
    vcs_info
  }

  PROMPT='%F{cyan}%n%f %1~%F{yellow}${vcs_info_msg_0_}%f '
fi

# --- Aliases útiles (Podman & CLI Moderna en Debian) ---
alias p="podman"
alias pc="podman compose"
alias docker="podman"
alias d="podman"
alias dc="podman compose"

command -v fdfind &>/dev/null && ! command -v fd &>/dev/null && alias fd="fdfind"
command -v batcat &>/dev/null && ! command -v bat &>/dev/null && alias bat="batcat"

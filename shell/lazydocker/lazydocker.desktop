[Desktop Entry]
Name=Lazydocker
GenericName=Container Manager
Comment=TUI for Podman and Docker containers
TryExec=foot
Exec=sh -c 'PATH="$HOME/.local/bin:$PATH" exec foot -e lazydocker'
Icon=utilities-terminal
Terminal=false
Type=Application
Categories=System;Monitor;Development;
Keywords=podman;docker;containers;lazydocker;devops;
StartupNotify=false

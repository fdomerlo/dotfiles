{
  "layer": "top",
  "position": "top",
  "height": 40,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 0,

  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "custom/media",
    "hyprland/window"
  ],
  "modules-center": [],
  "modules-right": [
    "cpu",
    "memory",
    "power-profiles-daemon",
    "idle_inhibitor",
    "backlight",
    "battery",
    "pulseaudio",
    "network",
    "custom/vpn",
    "bluetooth",
    "custom/notification",
    "custom/nightlight",
    "custom/recording",
    "clock",
    "tray",
    "custom/power"
  ],

  "custom/launcher": {
    "format": ">_",
    "on-click": "~/.config/hypr/scripts/toggle-menu.sh 'Buscar aplicaciones' env XDG_CURRENT_DESKTOP=Hyprland:GNOME fuzzel --placeholder 'Buscar aplicaciones...'",
    "tooltip": true,
    "tooltip-format": "Lanzador de aplicaciones (Super + D)"
  },

  "hyprland/workspaces": {
    "format": "[{name}]",
    "on-click": "activate",
    "disable-scroll": false,
    "all-outputs": false
  },

  "custom/media": {
    "format": ">> {text}",
    "max-length": 35,
    "interval": 3,
    "exec": "playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip": true,
    "tooltip-format": "Reproductor multimedia (Click: Pausa/Play)"
  },

  "hyprland/window": {
    "format": "{title}",
    "separate-outputs": true
  },

  "cpu": {
    "format": "CPU {usage}%",
    "interval": 2,
    "tooltip": true,
    "on-click": "foot -e btop"
  },

  "memory": {
    "format": "MEM {used:0.1f}G",
    "interval": 2,
    "tooltip-format": "Memoria en uso: {used:0.2f}GiB de {total:0.2f}GiB",
    "on-click": "foot -e btop"
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Perfil de energía: {profile}\nDriver: {driver}\nClick para alternar",
    "tooltip": true,
    "format-icons": {
      "default": "BAL",
      "performance": "PERF",
      "balanced": "BAL",
      "power-saver": "SAVE"
    }
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    },
    "tooltip-format-activated": "Inhibidor de reposo: ACTIVO\nLa pantalla no se bloqueará por inactividad",
    "tooltip-format-deactivated": "Inhibidor de reposo: inactivo\nClick para evitar bloqueo/apagado de pantalla"
  },

  "backlight": {
    "format": "BRI {percent}%",
    "on-scroll-up": "~/.config/hypr/scripts/osd.sh brightness raise",
    "on-scroll-down": "~/.config/hypr/scripts/osd.sh brightness lower",
    "tooltip-format": "Brillo: {percent}%"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "BAT {capacity}%",
    "format-charging": "CHG {capacity}%",
    "format-plugged": "AC {capacity}%",
    "tooltip-format": "{timeTo}\nConsumo: {power} W"
  },

  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "MUTE",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "tooltip": true,
    "tooltip-format": "Volumen: {volume}%"
  },

  "network": {
    "format-wifi": "NET {essid}",
    "format-ethernet": "NET LAN",
    "format-disconnected": "SIN RED",
    "tooltip-format": "{ifname} via {gwaddr}",
    "on-click": "~/.config/hypr/scripts/toggle-menu.sh 'Red:' ~/.config/hypr/scripts/network-menu.sh",
    "on-click-right": "nm-connection-editor"
  },

  "custom/vpn": {
    "format": "{}",
    "exec": "~/.config/hypr/scripts/vpn-status.sh",
    "interval": 2,
    "on-click": "~/.config/hypr/scripts/toggle-menu.sh 'Red:' ~/.config/hypr/scripts/network-menu.sh",
    "tooltip": true,
    "return-type": "json"
  },

  "bluetooth": {
    "format": "BT",
    "format-disabled": "BT OFF",
    "format-connected": "BT {device_alias}",
    "format-connected-battery": "BT {device_alias} ({device_battery_percentage}%)",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} conectados",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} conectados\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t({device_battery_percentage}%)",
    "on-click": "blueman-manager"
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "command -v swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "~/.config/hypr/scripts/notifications-toggle.sh",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "custom/nightlight": {
    "format": "{}",
    "exec": "~/.config/hypr/scripts/nightlight-status.sh",
    "return-type": "json",
    "interval": 2,
    "hide-empty-text": true,
    "on-click": "~/.config/hypr/scripts/nightlight-toggle.sh",
    "tooltip": true
  },

  "custom/recording": {
    "format": "{}",
    "exec": "~/.config/hypr/scripts/recording-status.sh",
    "return-type": "json",
    "interval": 1,
    "hide-empty-text": true,
    "on-click": "~/.config/hypr/scripts/screen-record.sh",
    "tooltip": true
  },

  "clock": {
    "format": "{:L%A, %d de %B %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "locale": "es_AR.UTF-8",
    "timezone": "America/Argentina/Buenos_Aires",
    "on-click": "gnome-calendar",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#4f9fbf'><b>{}</b></span>",
        "weekdays": "<span color='#8fa6b5'><b>{}</b></span>",
        "days": "<span color='#c3d2dd'>{}</span>",
        "weeks": "<span color='#5f7684'>W{}</span>",
        "today": "<span color='#c83434'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": true,
    "tooltip-format": "Menú del sistema (Apagar / Cerrar sesión)",
    "on-click": "~/.config/hypr/scripts/toggle-menu.sh 'Sistema:' ~/.config/hypr/scripts/powermenu.sh"
  }
}

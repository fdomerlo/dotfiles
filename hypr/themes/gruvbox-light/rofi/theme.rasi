/* ==============================================================================
 * Rofi 2.0 - gruvbox-light · Whitesmoke
 * Base whitesmoke translúcida, tinta grafito y selección slate.
 * ============================================================================== */

* {
    bg:          #f5f5f5e6;
    bg-alt:      #ebebebe6;
    fg:          #2f2f2fff;
    fg-muted:    #767676ff;
    accent:      #4f5d6bff;
    accent-hi:   #3a4754ff;
    sel-fg:      #f5f5f5ff;
    border-col:  #d9d9d9ff;
    urgent:      #cc241dff;

    font: "Inter 11";
    background-color: transparent;
    text-color: @fg;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location: center;
    anchor: center;
    width: 720px;
    background-color: @bg;
    border: 1px solid;
    border-color: @border-col;
    border-radius: 12px;
}

mainbox {
    padding: 18px;
    spacing: 12px;
    children: [ "inputbar", "mode-switcher", "message", "listview" ];
}

inputbar {
    padding: 10px 14px;
    spacing: 10px;
    background-color: @bg-alt;
    border: 1px solid;
    border-color: @border-col;
    border-radius: 8px;
    children: [ "prompt", "entry" ];
}

prompt {
    text-color: @accent;
    vertical-align: 0.5;
}

entry {
    placeholder: "Buscar aplicaciones, acciones o comandos...";
    placeholder-color: @fg-muted;
    cursor: text;
    vertical-align: 0.5;
}

mode-switcher {
    spacing: 6px;
}

button {
    padding: 7px 10px;
    background-color: @bg-alt;
    text-color: @fg-muted;
    border-radius: 8px;
    cursor: pointer;
}

button selected {
    background-color: @accent;
    text-color: @sel-fg;
}

message {
    padding: 8px 12px;
    background-color: @bg-alt;
    border-radius: 8px;
}

textbox {
    text-color: @fg-muted;
}

listview {
    lines: 10;
    columns: 1;
    fixed-height: true;
    scrollbar: false;
    spacing: 4px;
}

element {
    padding: 8px 12px;
    spacing: 10px;
    border-radius: 8px;
    cursor: pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @accent;
    text-color: @sel-fg;
}

element normal.urgent,
element alternate.urgent {
    text-color: @urgent;
}

element selected.urgent {
    background-color: @urgent;
    text-color: @sel-fg;
}

element-icon {
    size: 22px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    highlight: bold underline;
}

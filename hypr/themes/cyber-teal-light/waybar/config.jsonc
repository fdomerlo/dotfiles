{
  "include": ["~/.config/waybar/local.jsonc"],
  "layer": "top",
  "position": "top",
  "height": 40,
  "margin-top": 4,
  "margin-left": 4,
  "margin-right": 4,
  "spacing": 4,

  "modules-left": [
    "custom/launcher",
    "ext/workspaces",
    "custom/media",
    "hyprland/window"
  ],
  "modules-center": [],
  "modules-right": [
    "cpu",
    "memory",
    "power-profiles-daemon",
    "idle_inhibitor",
    "backlight",
    "battery",
    "pulseaudio",
    "network",
    "custom/vpn",
    "bluetooth",
    "custom/notification",
    "custom/ai-service",
    "custom/nightlight",
    "custom/recording",
    "clock",
    "tray",
    "custom/power"
  ],

  "custom/launcher": {
    "format": ">_",
    "on-click": "~/.config/hypr/scripts/launcher-toggle.sh",
    "on-click-right": "~/.config/hypr/scripts/overview-toggle.sh",
    "tooltip": true,
    "tooltip-format": "Click izq.: Centro Unificado (Super)\nClick der.: Selector de ventanas (Super + A)"
  },

  "ext/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-id": true,
    "all-outputs": false,
    "ignore-hidden": true
  },

  "custom/media": {
    "format": "󰎆 {text}",
    "max-length": 35,
    "interval": 3,
    "exec": "playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip": true,
    "tooltip-format": "Reproductor multimedia (Click: Pausa/Play)"
  },

  "hyprland/window": {
    "format": "{title}",
    "separate-outputs": true
  },

  "cpu": {
    "format": " {usage}%",
    "interval": 2,
    "tooltip": true,
    "on-click": "foot -e btop"
  },

  "memory": {
    "format": "󰍛 {used:0.1f}G",
    "interval": 2,
    "tooltip-format": "Memoria en uso: {used:0.2f}GiB de {total:0.2f}GiB",
    "on-click": "foot -e btop"
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Perfil de energía: {profile}\nDriver: {driver}\nClick para alternar",
    "tooltip": true,
    "format-icons": {
      "default": "󰾅",
      "performance": "󰓅",
      "balanced": "󰾅",
      "power-saver": "󰌪"
    }
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    },
    "tooltip-format-activated": "Inhibidor de reposo: ACTIVO\nEl equipo no se bloqueará, suspenderá ni hibernará automáticamente",
    "tooltip-format-deactivated": "Inhibidor de reposo: inactivo\nClick para evitar bloqueo, suspensión e hibernación automática"
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "~/.config/hypr/scripts/osd.sh brightness raise",
    "on-scroll-down": "~/.config/hypr/scripts/osd.sh brightness lower",
    "tooltip-format": "Brillo: {percent}%"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}\nConsumo: {power} W"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "tooltip": true,
    "tooltip-format": "Volumen: {volume}%"
  },

  "network": {
    "format-wifi": " {essid}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰪎",
    "tooltip-format": "{ifname} via {gwaddr}",
    "on-click": "~/.config/hypr/scripts/toggle-menu.sh 'Red:' ~/.config/hypr/scripts/network-menu.sh",
    "on-click-right": "nm-connection-editor"
  },

  "custom/vpn": {
    "format": "{}",
    "exec": "~/.config/hypr/scripts/vpn-status.sh",
    "interval": 2,
    "on-click": "~/.config/hypr/scripts/toggle-menu.sh 'Red:' ~/.config/hypr/scripts/network-menu.sh",
    "tooltip": true,
    "return-type": "json"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {device_alias}",
    "format-connected-battery": "󰂱 {device_alias} ({device_battery_percentage}%)",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} conectados",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} conectados\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t({device_battery_percentage}%)",
    "on-click": "blueman-manager"
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "command -v swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "~/.config/hypr/scripts/notifications-toggle.sh",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "custom/ai-service": {
    "format": "{}",
    "exec": "~/.config/hypr/scripts/ai-service-status.sh",
    "return-type": "json",
    "interval": 5,
    "signal": 9,
    "on-click": "~/.config/hypr/scripts/ai.sh menu",
    "on-click-right": "~/.config/hypr/scripts/ai.sh service toggle",
    "tooltip": true
  },

  "custom/nightlight": {
    "format": "{}",
    "exec": "~/.config/hypr/scripts/nightlight-status.sh",
    "return-type": "json",
    "interval": 2,
    "hide-empty-text": true,
    "on-click": "~/.config/hypr/scripts/nightlight-toggle.sh",
    "tooltip": true
  },

  "custom/recording": {
    "format": "{}",
    "exec": "~/.config/hypr/scripts/recording-status.sh",
    "return-type": "json",
    "interval": 1,
    "hide-empty-text": true,
    "on-click": "~/.config/hypr/scripts/screen-record.sh",
    "tooltip": true
  },

  "clock": {
    "format": "󰃭 {:L%A, %d %B %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "locale": "es_AR.UTF-8",
    "timezone": "America/Argentina/Buenos_Aires",
    "on-click": "gnome-calendar",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#007a91'><b>{}</b></span>",
        "weekdays": "<span color='#5c737a'><b>{}</b></span>",
        "days": "<span color='#162328'>{}</span>",
        "weeks": "<span color='#84989e'>W{}</span>",
        "today": "<span color='#c4324b'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": true,
    "tooltip-format": "Menú del sistema (Super + X)",
    "on-click": "~/.config/hypr/scripts/toggle-menu.sh 'Sistema:' ~/.config/hypr/scripts/powermenu.sh"
  }
}

{
  "layer": "top",
  "position": "top",
  "height": 42,
  "margin-top": 8,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 4,

  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "custom/media",
    "hyprland/window"
  ],
  "modules-center": [],
  "modules-right": [
    "cpu",
    "memory",
    "pulseaudio",
    "network",
    "bluetooth",
    "custom/notification",
    "clock",
    "tray",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "󰀻",
    "on-click": "env XDG_CURRENT_DESKTOP=Hyprland:GNOME wofi --show drun",
    "tooltip": true,
    "tooltip-format": "Lanzador de aplicaciones (Super + D)"
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "disable-scroll": false,
    "all-outputs": false
  },

  "custom/media": {
    "format": "󰎆 {text}",
    "max-length": 35,
    "interval": 3,
    "exec": "playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip": true,
    "tooltip-format": "Reproductor multimedia (Click: Pausa/Play)"
  },

  "hyprland/window": {
    "format": "{title}",
    "separate-outputs": true
  },

  "cpu": {
    "format": " {usage}%",
    "interval": 2,
    "tooltip": true,
    "on-click": "kitty -e btop"
  },

  "memory": {
    "format": "󰍛 {used:0.1f}G",
    "interval": 2,
    "tooltip-format": "Memoria en uso: {used:0.2f}GiB de {total:0.2f}GiB",
    "on-click": "kitty -e btop"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 MUTE",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "tooltip": true,
    "tooltip-format": "Volumen: {volume}%"
  },

  "network": {
    "format-wifi": " {essid}",
    "format-ethernet": "󰈀 LAN",
    "format-disconnected": "󰪎 Sin red",
    "tooltip-format": "{ifname} via {gwaddr}",
    "on-click": "nm-connection-editor"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {device_alias}",
    "format-connected-battery": "󰂱 {device_alias} ({device_battery_percentage}%)",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} conectados",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} conectados\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t({device_battery_percentage}%)",
    "on-click": "blueman-manager"
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "command -v swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "~/.config/hypr/scripts/notifications-toggle.sh",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "clock": {
    "format": "󰃭 {:%H:%M}",
    "tooltip-format": "󰃭 {:L%A, %d de %B de %Y}",
    "locale": "es_AR.UTF-8",
    "timezone": "America/Argentina/Buenos_Aires"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": true,
    "tooltip-format": "Menú del sistema (Apagar / Cerrar sesión)",
    "on-click": "~/.config/hypr/scripts/toggle-wofi.sh 'Sistema:' ~/.config/hypr/scripts/powermenu.sh"
  }
}
